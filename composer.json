{
    "name": "brickservers/google-workspace",
    "description": "Modern Laravel package for managing Google Workspace (formerly G Suite) with support for Directory API, Classroom, Calendar, Gmail, and Drive APIs",
    "keywords": [
        "brickservers",
        "google-workspace",
        "gsuite",
        "laravel",
        "admin-sdk",
        "directory-api",
        "classroom-api",
        "calendar-api",
        "gmail-api",
        "drive-api"
    ],
    "homepage": "https://github.com/brickservers/google-workspace",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Wallace Myem",
            "email": "wallace@brickng.com",
            "role": "Developer"
        },
        {
            "name": "Original Authors",
            "email": "contact@wyattcast44.dev",
            "role": "Original Developer"
        }
    ],
    "require": {
        "php": ">=8.2",
        "google/apiclient": "^2.20|^3.0",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/contracts": "^10.0|^11.0|^12.0|^13.0",
        "psr/log": "^1.1|^2.0|^3.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0",
        "phpunit/phpunit": "^10.0|^11.0",
        "laravel/pint": "^1.13",
        "phpstan/phpstan": "^1.10"
    },
    "autoload": {
        "psr-4": {
            "BrickServers\\GoogleWorkspace\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BrickServers\\GoogleWorkspace\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test-coverage": "vendor/bin/phpunit --coverage-html coverage",
        "lint": "vendor/bin/pint",
        "analyze": "vendor/bin/phpstan analyse"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "BrickServers\\GoogleWorkspace\\GoogleWorkspaceServiceProvider"
            ],
            "aliases": {
                "GSuite": "Wyattcast44\\GSuite\\Facades\\GSuiteFacade"
            }
        }
    }
}
